# Copy to .env next to docker-compose.yml. No secrets here: the API key, game token and dashboard password are set in
# the dashboard and stored in ${SIDECAR_DATA_DIR}/sidecar-config.json.

# build context: local path (default ..) or git URL with a subdir
SIDECAR_BUILD_CONTEXT=https://github.com/underlines/reforger-clausewitz.git#main:dev/tools
# settings + caches (writable by uid 1000)
SIDECAR_DATA_DIR=/srv/clausewitz-sidecar
# Arma Reforger install (the folder with addons/), read-only, for the dashboard map; leave unset for no map
GAME_DIR=/srv/reforger/server
# host loopback port the game server calls (the mod default is 8788)
SIDECAR_PORT=8788
TZ=Europe/Zurich

# reverse proxy (Traefik)
TRAEFIK_ENABLE=true
PROXY_NETWORK=rp-shared
SIDECAR_HOST=clausewitz.example.com
CLW_ALLOWED_HOSTS=clausewitz.example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_MIDDLEWARES=
