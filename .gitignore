# IDE / user state
.idea/
*.user

# Temp / backup / logs
*.tmp
*.bak
*.log
logs/

# Tooling
.claude/

# Build output
build/
dist/
publish/

# NOT ignored on purpose: *.meta, *.rdb, *.gproj

# MCP handler scripts, copied in by wb_launch and removed by wb_cleanup
addon/Scripts/WorkbenchGame/
dev/testpacks/**/Scripts/WorkbenchGame/
dev/testpacks/**/*.rdb
dev/testpacks/**/.wb/

# Sidecar settings (may contain an API key)
dev/tools/sidecar-config.json

# Local secrets / sidecar settings
dev/.env

# Extracted map imagery cache (do not commit BI content)
dev/tools/.cache/

# Sidecar npm dependencies (AI SDK, agent turn)
dev/tools/node_modules/

# sidecar started as a detached process (pid file + stderr log)
dev/tools/sidecar.pid
*.log.err
